        <id>small_shopping_cart_v4_mq.html</id>
        <sp_widget display_value="CSM Shopping Cart MQ">889fa46d83b1a650fbeb40526daad354</sp_widget>
        <sys_class_name>sp_ng_template</sys_class_name>
